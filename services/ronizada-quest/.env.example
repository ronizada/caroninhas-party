# RONIZADA QUEST V1.3 — SOMENTE SERVICO DE PERGUNTAS.
# Copie para .env, preencha e NUNCA publique os valores verdadeiros.
PORT=8081
HOST=0.0.0.0
AUTO_IMPORT=if_empty
DATABASE_SSL=false

# Para desenvolvimento local, usar DATABASE_URL com usuario RESTRITO,
# proprietario do schema trivia. O codigo exige URL quando DB_HOST=localhost.
# Se a senha possuir @, : ou /, codifique-a na URL (percent-encoding).
DATABASE_URL=postgresql://caroninhas_trivia_api:SENHA_LOCAL_CODIFICADA@127.0.0.1:5432/caroninhas_party_local

# Em hospedagem, alternativa ao DATABASE_URL:
# DB_HOST=HOST_PRIVADO
# DB_PORT=5432
# DB_NAME=BANCO
# DB_USER=caroninhas_trivia_api
# DB_PASSWORD=SENHA_RESTRITA

# Minimo de 24 caracteres aleatorios, distintas entre si.
# Nao use os textos de exemplo como chaves reais.
TRIVIA_API_KEY=SUBSTITUIR_POR_CHAVE_SERVICO_ALEATORIA_24_OU_MAIS
TRIVIA_ADMIN_KEY=SUBSTITUIR_POR_OUTRA_CHAVE_ADMIN_ALEATORIA_24_OU_MAIS
