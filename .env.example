# PORTAL CARONINHAS PARTY — exemplo LOCAL sem credenciais reais.
# Copie para .env e preencha. NUNCA adicione .env ao GitHub.
PORT=8080
AUTO_INIT_DB=false

# Conexao local: npm run db:init cria o banco caso a conta tenha permissao.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=SUBSTITUA_PELA_SENHA_LOCAL
DB_NAME=caroninhas_party_local
# Em hospedagem, alternativa: DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO

# API separada; a chave deve ser IGUAL a TRIVIA_API_KEY da Ronizada Quest.
TRIVIA_API_URL=http://127.0.0.1:8081
TRIVIA_API_KEY=SUBSTITUA_PELA_MESMA_CHAVE_ALEATORIA_DA_TRIVIA

# Servicos externos opcionais para imagens de personagens (se configurados):
# TMDB_READ_ACCESS_TOKEN=
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# IGDB_ACCESS_TOKEN=
